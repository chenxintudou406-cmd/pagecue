{
  "manifest_version": 3,
  "name": "页知 PageCue",
  "version": "3.2.10",
  "minimum_chrome_version": "116",
  "description": "在网页中呈现分级知识提醒、操作提醒和团队工具。",
  "permissions": [
    "storage",
    "scripting",
    "sidePanel",
    "notifications",
    "alarms",
    "tabs",
    "contextMenus"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*",
    "file:///*",
    "https://pagecue.herotop.cn/*",
    "http://127.0.0.1:8787/*",
    "http://localhost:8787/*"
  ],
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "icons": {
    "16": "assets/icon-16.png",
    "32": "assets/icon-32.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  },
  "action": {
    "default_title": "打开页知",
    "default_icon": {
      "16": "assets/icon-16.png",
      "32": "assets/icon-32.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel/index.html"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*",
        "file:///*"
      ],
      "js": [
        "shared/quick-create-policy.js",
        "shared/rule-engine.js",
        "shared/scroll-position.js",
        "content/content.js"
      ],
      "css": [
        "content/content.css"
      ],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["assets/icon-128.png"],
      "matches": ["<all_urls>"]
    }
  ]
}
