HOST=127.0.0.1
PORT=8787

# Required for the administrator console. Never commit real values.
ADMIN_PHONE=
ADMIN_PASSWORD_HASH=scrypt:<base64url-salt>:<base64url-hash>
ADMIN_SESSION_SECRET=<at-least-32-random-bytes>

# Required for the inbound WorkBuddy/WeCom reminder endpoint.
# Use a different random token from the administrator password.
WORKBUDDY_API_TOKEN=<at-least-32-random-bytes>

# Optional Web Push configuration.
VAPID_SUBJECT=https://pagecue.herotop.cn
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
